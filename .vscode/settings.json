{
  "files.associations": {
    "*.sv": "systemverilog",
    "*.svh": "systemverilog"
  },
  "verilog.linting.linter": "verilator",
  "verilog.linting.verilator.arguments": "--sv -Wall",
  "verilog.linting.verilator.runAtFileLocation": false,
  "python.defaultInterpreterPath": "${workspaceFolder}/.venv/bin/python",
  "terminal.integrated.env.linux": {
    "PATH": "${env:HOME}/opt/oss-cad-suite/bin:${env:PATH}"
  },
  "editor.tabSize": 4,
  "files.exclude": {
    "**/__pycache__": true,
    "**/build": true
  }
}
